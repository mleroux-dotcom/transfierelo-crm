# ───────── Transporte ─────────
# stdio = uso local (Claude Code / Claude Desktop lanzan el proceso)
# http  = uso remoto (endpoint POST /mcp + GET /healthz)
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3333
# Obligatorio en modo http. Genera uno con: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Hosts aceptados en la cabecera Host (protección DNS rebinding) si expones el servidor, p. ej. mcp.midominio.cl
MCP_ALLOWED_HOSTS=
# Solo pruebas locales: permite http sin token (únicamente en 127.0.0.1)
MCP_ALLOW_NO_AUTH=false

# ───────── Comportamiento ─────────
LOG_LEVEL=info                 # debug | info | warn | error (siempre a stderr)
CACHE_TTL_SECONDS=300          # caché de respuestas de las APIs de origen
CACHE_MAX_ENTRIES=1000
HTTP_TIMEOUT_MS=15000          # timeout por petición
HTTP_RETRIES=3                 # reintentos ante 429/5xx/red (backoff exponencial + Retry-After)
SOURCE_TIMEOUT_MS=12000        # tiempo máximo por fuente dentro de "investigar"
TASKS_MAX_CONCURRENT=2         # tareas en segundo plano simultáneas
MAX_DOWNLOAD_MB=20             # tamaño máximo al leer URLs

# ───────── Fuentes ─────────
# Desactiva fuentes (separadas por comas): wikipedia,wikidata,openalex,crossref,pubmed,arxiv,worldbank,github,web,busqueda_web,feeds,documentos,crm
SOURCES_DISABLED=
WIKIPEDIA_LANG=es
# Email de contacto: entra en el "polite pool" de OpenAlex/Crossref/NCBI (más rápido y estable)
CONTACT_EMAIL=

# GitHub: opcional. Sin token = 60 peticiones/hora y sin búsqueda de código.
# Basta un token "fine-grained" de solo lectura sobre repos públicos.
GITHUB_TOKEN=
# PubMed: opcional, sube el límite de 3 a 10 peticiones/segundo
NCBI_API_KEY=

# Buscador web (uno de los dos): https://brave.com/search/api  o tu propia instancia SearXNG
BRAVE_API_KEY=
SEARXNG_URL=
# Permitir leer URLs de red local/privada con leer_url (por seguridad: false)
ALLOW_PRIVATE_URLS=false

# Documentos propios: carpeta con PDF, DOCX, MD, TXT, HTML, CSV, JSON (se indexa recursivamente)
DOCS_DIR=
DOCS_MAX_FILE_MB=25

# ───────── CRM Transfiereloo (opcional) ─────────
CRM_BASE_URL=
CRM_API_KEY=
# Escritura en el CRM (crear contacto/tarea, actualizar oportunidad, completar tarea).
# Aun activada, cada escritura exige confirmación explícita en dos pasos.
ALLOW_WRITES=false
