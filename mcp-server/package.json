{
  "name": "fuentes-mcp",
  "version": "1.0.0",
  "description": "Servidor MCP de fuentes fidedignas: Wikipedia, Wikidata, OpenAlex, Crossref, PubMed, arXiv, Banco Mundial, GitHub, web, RSS, documentos propios y CRM.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "inspector": "npm run build && npx -y @modelcontextprotocol/inspector node dist/index.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fast-xml-parser": "^5.12.1",
    "mammoth": "^1.13.0",
    "unpdf": "^2.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "bin": {
    "fuentes-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ]
}
