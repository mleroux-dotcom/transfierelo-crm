# Contraseña para entrar a la web del CRM
CRM_PASSWORD=cambia-esta-contraseña
# Clave para la API (la que usarás desde Emergent). Pon una larga y aleatoria.
CRM_API_KEY=cambia-esta-clave-api
# Secreto para firmar la sesión (cualquier texto largo y aleatorio)
CRM_SECRET=cambia-este-secreto

# Webs desde las que se aceptan formularios (separadas por comas)
CRM_ALLOWED_ORIGINS=https://transfiereloo.cl,https://www.transfiereloo.cl
# Dominio propio para el CRM (crealo como subdominio para no tocar tu web)
CRM_DOMINIO=crm.transfiereloo.cl
